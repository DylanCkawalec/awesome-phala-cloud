# Example env for RA Dashboard

# Required
PHALA_API_KEY=

# Optional / recommended
DSTACK_API_KEY=
DSTACK_ENDPOINT=https://api.dstack.network
PHALA_ENDPOINT=https://api.phala.network

# App metadata (used by frontend for attestation payloads)
APP_NAME=remote-attestation-dashboard
APP_VERSION=1.0.0
DEVELOPER_NAME=Your Name
ORGANIZATION=Your Org
NODE_ENV=production

# Attestation parameters (frontend service)
ATTESTATION_SEED=phala-attestation-seed
ATTESTATION_SALT=phala-attestation-salt

# Optional identifiers (if used by your backend or gateway)
PHALA_CLUSTER_ID=
PHALA_CONTRACT_ID=

